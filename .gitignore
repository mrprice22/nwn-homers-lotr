/.nasher/
/dist/
/module-index/*
!/module-index/.gitkeep
*.mod
*.ncs
*.erf
*.hak
/tlk/
/server.env.local

# Admin CD-key whitelist seed — contains plaintext public CD keys; lives only on
# this machine and is loaded into the admindb campaign DB out of band. The
# admindb itself is a campaign SQLite file (never part of the .mod or this repo).
/bin/seed-admindb.sh

# Roadmap player name -> meritdb CD key, learned when you pick a submitter by
# hand in the roadmap editor's award dialog. Same reasoning as above: plaintext
# public CD keys, machine-local, never in the repo or the .mod.
/roadmap-merit-aliases.json

# Credit sidecar for the wiki build: who submitted and who tested each idea,
# regenerated by bin/gen-roadmap.py in the same run as docs.manual/Roadmap.html.
# Contains nothing the public roadmap page does not already show, but it is a
# build artifact of roadmap.yaml, so it is derived rather than kept.
/roadmap-credits.json
__pycache__/
*.pyc

# LibreOffice lock files
.~lock.*#

# build-stamp script generated at repack; leaks into unpacked/ via toolset round-trip unpacks
unpacked/nwnmgr_bstamp.nss

# autopilot mid-item marker — local machine-only state, never needs to travel with the repo
/autopilot-wip.md

# Advisory lock guarding concurrent roadmap.yaml writers (editor + apply-patch)
.roadmap.yaml.lock

# Local-LLM harness (bin/llm/) response cache — keyed by model+prompt+schema hash.
# Pure derived data, regenerated on demand, and large. The ledger under
# llm-changes/ IS tracked; only the cache and its temp files are not.
/.llm-cache/
/llm-changes/*.tmp
/.llm-harness.lock

# Release-note flavor sidecars (bin/gen-release-notes.py --flavor). Derived from
# roadmap.yaml + a commit range; regenerated with --regen-flavor. Kept out of git
# because the range they are keyed on closes at the next promotion.
/release-notes/

# Roadmap-editor credentials. These normally live OUTSIDE the repo
# (~/.local/share/roadmap-editor/ and ~/.config/roadmap-editor/), and they hold
# password hashes, live session tokens and the Cloudflare Tunnel connector
# token. Ignored here as a backstop for a ROADMAP_AUTH_DB pointed at the
# working tree, or a token file copied in "just to look at it" — the same
# reasoning as bin/seed-admindb.sh. Note that .gitignore alone would NOT be
# enough if these ever lived under unpacked/: nasher packs that whole directory
# regardless of git. Keep them out of unpacked/ as well.
auth.sqlite3
auth.sqlite3-*
tunnel.env
