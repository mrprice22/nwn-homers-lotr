#!/usr/bin/env bash
# build-lotr-music-hak — pack the custom music into lotr_music.hak and install it.
#
# Contents: hak_music/ambientmusic.2da plus every music/bmu/*.bmu. Both are
# generated by bin/gen-music-tracks.py from the MP3 masters in
# ~/OneDrive/Games/NWNHomersLOTR/music/mp3/ — run that first.
#
# WHY MUSIC GETS ITS OWN HAK, SEPARATE FROM lotr_rules.hak
# --------------------------------------------------------
# Music is megabytes and grows every time a song is added; the rules 2DAs are
# kilobytes and change rarely. Keeping them apart means adding a song does not
# rebuild the rules hak, and does not churn its NWSync blobs — NWSync is
# content-addressed per file, so a rewritten rules hak is a fresh multi-MB
# download for every client even when not one rule changed.
#
# WHY THE FILE LIST IS A GLOB HERE, UNLIKE build-lotr-rules-hak
# -------------------------------------------------------------
# That script hardcodes its 2DA array because a silently-dropped rules table is
# a real and repeated failure (it happened twice). Music is the opposite case:
# tracks are added continuously and the authoritative list already lives in
# music/tracks.json. So we glob, and cross-check the glob against that manifest
# instead — a track in the manifest with no .bmu on disk is a hard error.
#
# Usage:
#   bin/build-lotr-music-hak              # build to dist/ and verify (no install)
#   bin/build-lotr-music-hak --install    # ... and install into $NWN_HOME_DIR/hak
#   bin/build-lotr-music-hak --install --home "/path/to/other NWN home"
#
# --install also drops a copy at the OneDrive root, next to lotr_rules.hak and
# lotr_iprp.hak. That copy is how the Windows toolset PC gets the hak — without
# it the new tracks do not appear in the toolset's area Music dropdown.
#
# After installing: bin/refresh-nwsync (the hak set changed, so clients need it)
# and then restart the server.

set -euo pipefail

PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ENV_FILE="$PROJECT_ROOT/server.env"
LOCAL_ENV_FILE="$PROJECT_ROOT/server.env.local"

ONEDRIVE_DIR="${ONEDRIVE_DIR:-$HOME/OneDrive/Games/NWNHomersLOTR}"

INSTALL=0
EXTRA_HOMES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --install) INSTALL=1 ;;
    --home)    shift; [[ $# -gt 0 ]] || { echo "--home needs a directory" >&2; exit 2; }
               EXTRA_HOMES+=("$1") ;;
    -h|--help) sed -n '2,32p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

# shellcheck disable=SC1090
. "$ENV_FILE"
[[ -f $LOCAL_ENV_FILE ]] && . "$LOCAL_ENV_FILE"
: "${NWN_HOME_DIR:?server.env must define NWN_HOME_DIR}"

NWN_ERF="${NWN_ERF:-$HOME/.nimble/bin/nwn_erf}"
if [[ ! -x $NWN_ERF ]]; then
  echo "error: nwn_erf not found at $NWN_ERF" >&2
  echo "       install niv/neverwinter.nim or set NWN_ERF in server.env.local" >&2
  exit 1
fi

TWODA="$PROJECT_ROOT/hak_music/ambientmusic.2da"
BMU_DIR="$PROJECT_ROOT/music/bmu"
MANIFEST="$PROJECT_ROOT/music/tracks.json"
OUT_DIR="$PROJECT_ROOT/dist"
OUT_HAK="$OUT_DIR/lotr_music.hak"

if [[ ! -f $TWODA ]]; then
  echo "error: missing $TWODA" >&2
  echo "       run: python3 bin/gen-music-tracks.py --apply" >&2
  exit 1
fi

# Cross-check the manifest against what is actually on disk. A live track whose
# .bmu is missing would pack a 2DA row pointing at nothing: the toolset lists
# the name, the area plays silence, and nothing anywhere reports an error.
if [[ -f $MANIFEST ]]; then
  missing=0
  while read -r resref; do
    [[ -n $resref ]] || continue
    if [[ ! -f "$BMU_DIR/$resref.bmu" ]]; then
      echo "error: tracks.json lists $resref but $BMU_DIR/$resref.bmu is missing" >&2
      missing=1
    fi
  done < <(python3 -c "
import json,sys
for t in json.load(open(sys.argv[1]))['tracks']:
    if not t.get('retired'): print(t['resref'])
" "$MANIFEST")
  [[ $missing -eq 0 ]] || {
    echo "       run: python3 bin/gen-music-tracks.py --apply" >&2
    exit 1
  }
fi

shopt -s nullglob
BMUS=("$BMU_DIR"/*.bmu)
shopt -u nullglob
if [[ ${#BMUS[@]} -eq 0 ]]; then
  echo "error: no .bmu files in $BMU_DIR" >&2
  echo "       run: python3 bin/gen-music-tracks.py --apply" >&2
  exit 1
fi

# NWSync refuses to publish a file larger than 15 MB — the track would simply
# never reach a client, with no error at either end.
for f in "${BMUS[@]}"; do
  size=$(stat -c %s "$f")
  if [[ $size -gt $((15 * 1024 * 1024)) ]]; then
    echo "error: $(basename "$f") is $((size / 1048576)) MB, over NWSync's 15 MB limit" >&2
    exit 1
  fi
done

mkdir -p "$OUT_DIR"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT
cp "$TWODA" "$STAGE/ambientmusic.2da"
for f in "${BMUS[@]}"; do cp "$f" "$STAGE/$(basename "$f")"; done

echo "[hak] packing ambientmusic.2da + ${#BMUS[@]} track(s) -> $OUT_HAK"
staged=("$STAGE/ambientmusic.2da")
for f in "${BMUS[@]}"; do staged+=("$STAGE/$(basename "$f")"); done
"$NWN_ERF" -c -f "$OUT_HAK" -e HAK "${staged[@]}"

echo "[hak] contents:"
mapfile -t got < <("$NWN_ERF" -t -f "$OUT_HAK" | sed 's/[[:space:]]*$//' | sort)
printf '        %s\n' "${got[@]}"
mapfile -t want < <({ echo ambientmusic.2da; for f in "${BMUS[@]}"; do basename "$f"; done; } | sort)
if [[ "${got[*]}" != "${want[*]}" ]]; then
  echo "error: packed hak does not match the expected file list" >&2
  echo "       want: ${want[*]}" >&2
  echo "       got:  ${got[*]}" >&2
  exit 1
fi
echo "[hak] verified: all ${#want[@]} resource(s) present ($(du -h "$OUT_HAK" | cut -f1))"

if [[ $INSTALL -eq 0 ]]; then
  echo
  echo "Built but NOT installed. Install with:  $0 --install"
  exit 0
fi

install_into() {
  local home="$1" dest="$1/hak/lotr_music.hak"
  if [[ ! -d "$home/hak" ]]; then
    echo "[hak] skip (no hak dir): $home"
    return
  fi
  if [[ -f $dest ]]; then
    local bak="$dest.bak-$(date +%Y%m%d_%H%M%S)"
    cp -p "$dest" "$bak"
    echo "[hak] backed up -> $bak"
  fi
  cp "$OUT_HAK" "$dest"
  echo "[hak] installed -> $dest"
}

install_into "$NWN_HOME_DIR"
for h in ${EXTRA_HOMES+"${EXTRA_HOMES[@]}"}; do install_into "$h"; done

# The Windows toolset's copy. Same folder the other two LOTR haks already sit in.
if [[ -d $ONEDRIVE_DIR ]]; then
  cp "$OUT_HAK" "$ONEDRIVE_DIR/lotr_music.hak"
  echo "[hak] copied -> $ONEDRIVE_DIR/lotr_music.hak (for the Windows toolset)"
else
  echo "[hak] skip OneDrive copy (no $ONEDRIVE_DIR)"
fi

echo
echo "Next:"
echo "  1. repack the module      # lotr_music must be in Mod_HakList"
echo "  2. bin/refresh-nwsync     # publish the new hak to clients (run detached)"
echo "  3. restart the server"
