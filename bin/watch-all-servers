#!/usr/bin/env bash
# watch-all-servers — one live, read-only view of EVERY Homer's LotR realm on
# this box (dev/test, the live season, any archived season), interleaved into a
# single stream. Each line carries a realm tag and a realm colour:
#
#   [S2 ] 18:37:02   Ecthelion (Q6UY7GCH) Joined as Player 1   (green)
#   [DEV] 07:37:47   Server: Module loaded                     (cyan)
#   [S1 ] 03:12:04 E ERROR: script too long                    (red)
#
# Two things happen to the raw container stream before you see it:
#
#   * NOISE IS DROPPED. ~95% of the log is boilerplate a human never wants
#     (per-object NWNX_Damage hook churn, Anvil service load/unload, plugin
#     lists, forge chest opens). The patterns are in bin/server-log-noise.txt,
#     shared with the editor's /monitor page -- a blocklist, not an allowlist,
#     so unknown lines and W/E always print. `--raw` turns all of this off.
#
#   * THE BACKLOG IS TIME-MERGED. Every realm's history is collected first,
#     sorted into one chronological stream, and only then does the live follow
#     start. (Without this the realms' backlogs race each other and you get
#     03:12 next to 07:37 next to 03:12.)
#
# This is the cross-realm counterpart of bin/watch-server, which watches exactly
# one realm (the repo it lives in) and deliberately stays unfiltered as the
# raw-stream fallback. Both only WATCH. Neither ever starts or stops a server --
# that's the season server unit (systemd --user). Closing this window or hitting
# Ctrl+C just stops watching; every server keeps running headlessly.
#
# Run it from any terminal, over SSH, or via the "Server Monitor - All Realms"
# app launcher / the nwn-monitor-all.service autostart unit.
#
# Usage:
#   bin/watch-all-servers                 # every realm found
#   bin/watch-all-servers --only s2,dev   # just those (tags, case-insensitive)
#   bin/watch-all-servers --tail 300      # merged backlog depth (default 600)
#   bin/watch-all-servers --raw           # no filtering, no merge, no reformat
#   bin/watch-all-servers --show-dropped  # ONLY the lines the filter removed
#   bin/watch-all-servers --no-color      # plain text (also the default in a pipe)
set -uo pipefail

PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
GIT_ROOT=$(dirname "$PROJECT_ROOT")

# Default matches the tail= the editor's /monitor page requests, so both views
# open on the same history.
TAIL=600
ONLY=""
COLOR=auto
RAW=0
MODE=keep          # keep | dropped  (what the filter prints)

# The first line of --help is line 2; keep this in step with the header above.
HELP_LAST_LINE=38

while [[ $# -gt 0 ]]; do
  case "$1" in
    --only) ONLY="${2:-}"; shift 2 ;;
    --only=*) ONLY="${1#*=}"; shift ;;
    --tail) TAIL="${2:-600}"; shift 2 ;;
    --tail=*) TAIL="${1#*=}"; shift ;;
    --raw) RAW=1; shift ;;
    --show-dropped) MODE=dropped; shift ;;
    --no-color) COLOR=never; shift ;;
    --color=*) COLOR="${1#*=}"; shift ;;
    -h|--help) sed -n "2,${HELP_LAST_LINE}p" "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 0 ;;
    *) echo "error: unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ $TAIL =~ ^[0-9]+$ ]] || { echo "error: --tail wants a number, got '$TAIL'" >&2; exit 2; }

if [[ $COLOR == auto ]]; then
  [[ -t 1 ]] && COLOR=always || COLOR=never
fi

# --------------------------------------------------------------- noise list ---
# The blocklist itself lives in bin/server-log-noise.txt -- one ERE per line,
# shared verbatim with the roadmap editor's /monitor page, because an admin who
# sees a line in one monitor and not the other has no way to tell which view is
# lying. Read that file for the format and the rules on editing it.
NOISE_FILE="$PROJECT_ROOT/bin/server-log-noise.txt"
if [[ -r $NOISE_FILE ]]; then
  NOISE_RE=$(grep -vE '^[[:space:]]*(#|$)' "$NOISE_FILE" | paste -sd'|' -)
else
  # Say so rather than silently showing an unfiltered stream that looks fine.
  echo "warning: $NOISE_FILE missing — showing the unfiltered stream" >&2
  NOISE_RE='$^'                      # matches nothing
fi
# awk -v runs the value through string-escape processing before it ever becomes a
# regex, so every backslash has to survive twice: `\[` reaches awk as a bare `[`
# (and a warning) unless it is doubled here.
NOISE_RE_AWK=${NOISE_RE//\\/\\\\}

# ---------------------------------------------------------------- discovery ---
# Realms are sibling repos of this one: nwn_homers_lotr, _s1, _s2, ... Each is
# identified by its own server.env, exactly the way bin/watch-server identifies
# its single realm -- greped, never sourced, so a stray line in server.env can't
# execute anything here.
#
# There is deliberately NO fallback container name. With several realms on one
# host, a guessed name tails SOMEBODY ELSE'S SERVER and the output looks entirely
# plausible either way. Same reasoning as roadmap-editor.py's container_name().
env_get() {  # $1=file $2=key
  grep -E "^\s*(export\s+)?$2\s*=" "$1" 2>/dev/null \
    | tail -1 | cut -d= -f2- | sed 's/[[:space:]]*#.*$//' | tr -d '"'"'"' ' \
    | head -1
}

TAGS=(); LABELS=(); CONTAINERS=(); COLORS=(); HOMEDIRS=(); RUNDIRS=()

# Spare colours for any realm beyond the three we know: magenta, blue, red.
EXTRA_COLORS=(35 34 31)
extra_i=0

for repo in "$GIT_ROOT"/nwn_homers_lotr*; do
  env_file="$repo/server.env"
  [[ -f $env_file ]] || continue
  container=$(env_get "$env_file" NWN_CONTAINER_NAME)
  [[ -n $container ]] || continue
  role=$(env_get "$env_file" SEASON_ROLE)
  num=$(env_get "$env_file" SEASON_NUM)

  # Same tag rule as bin/season-shortcuts.sh: the dev realm is keyed on its ROLE
  # (it is permanent and carries whichever SEASON_NUM it currently feeds, so a
  # number-keyed tag would collide with that season's production repo).
  if [[ $role == dev ]]; then
    tag="DEV"; label="TEST realm"; color=36           # cyan
  else
    tag="S${num:-?}"; label="Season ${num:-?} (${role:-?})"
    case "$tag" in
      S1) color=33 ;;                                  # yellow
      S2) color=32 ;;                                  # green
      *)  color=${EXTRA_COLORS[$((extra_i % ${#EXTRA_COLORS[@]}))]}; ((extra_i++)) ;;
    esac
  fi

  TAGS+=("$tag"); LABELS+=("$label"); CONTAINERS+=("$container"); COLORS+=("$color")
  # Captured for the storage line in the banner below. Expanded by plain string
  # substitution, NOT eval: these values are greped out of server.env rather
  # than sourced precisely so a stray line there can never execute, and running
  # them through eval here would hand back exactly that capability.
  _hd=$(env_get "$env_file" NWN_HOME_DIR); HOMEDIRS+=("${_hd//\$HOME/$HOME}")
  _rd=$(env_get "$env_file" NWN_RUN_DIR);  RUNDIRS+=("${_rd//\$HOME/$HOME}")
done

if [[ ${#TAGS[@]} -eq 0 ]]; then
  echo "error: found no realms under $GIT_ROOT/nwn_homers_lotr*" >&2
  echo "       (a realm is a repo with NWN_CONTAINER_NAME set in its server.env)" >&2
  echo "       Refusing to guess a container name -- a wrong guess silently" >&2
  echo "       shows another realm's server." >&2
  exit 1
fi

# --only filter, matched against the tag (dev/DEV/s2/S2 all work).
if [[ -n $ONLY ]]; then
  want=",$(echo "$ONLY" | tr 'A-Z' 'a-z' | tr -d ' '),"
  T=(); L=(); C=(); K=()
  for i in "${!TAGS[@]}"; do
    t=$(echo "${TAGS[$i]}" | tr 'A-Z' 'a-z')
    if [[ $want == *",$t,"* ]]; then
      T+=("${TAGS[$i]}"); L+=("${LABELS[$i]}"); C+=("${CONTAINERS[$i]}"); K+=("${COLORS[$i]}")
    fi
  done
  if [[ ${#T[@]} -eq 0 ]]; then
    echo "error: --only '$ONLY' matched no realm. Known tags: ${TAGS[*]}" >&2
    exit 2
  fi
  TAGS=("${T[@]}"); LABELS=("${L[@]}"); CONTAINERS=("${C[@]}"); COLORS=("${K[@]}")
fi

# Widest tag, so the prefixes line up in a column.
TAGW=0
for t in "${TAGS[@]}"; do (( ${#t} > TAGW )) && TAGW=${#t}; done

paint() {  # $1=ansi-code $2=text ; bold when $3 is set
  if [[ $COLOR == never ]]; then printf '%s' "$2"
  elif [[ -n ${3:-} ]]; then printf '\033[1;%sm%s\033[0m' "$1" "$2"
  else printf '\033[%sm%s\033[0m' "$1" "$2"
  fi
}

# ------------------------------------------------------------------- tidier ---
# One awk program does all the per-line work, in both phases, so the backlog and
# the live stream can never disagree about what a line looks like or whether it
# is noise.
#
#   MODE=sort  -- buffer the whole (finite) backlog, resolve every timestamp,
#                 print "sortkey \t rendered" for merging across realms.
#   MODE=live  -- render and print immediately, flushing every line.
#   KEEP=0     -- invert the filter: print ONLY what would have been dropped.
#
# Three raw line shapes have to be reconciled:
#   I [2026/08/14 18:37:02.190] [Anvil.Services.Foo] message   (Anvil/.NET)
#   I [18:37:02] [NWNX_Damage] [Damage.cpp:152] message        (NWNX C++, no date)
#   {Masterserver Advisory} ...                                (nwserver, no time)
TIDY_AWK='
function paint(code, txt,   _) {
  if (!COLORON) return txt
  return "\033[" code "m" txt "\033[0m"
}
# nwserver and NWNX share one fd, so records arrive welded together, e.g.
#   Server: Loading module "X"I [07:37:35] [NWNX_ServerLogRedirector] ...
# and the module-load progress dots get a real record stuck on their end. Split
# on any "I [<digit>" that is not at the start of the line.
function unglue(line, out,   n, rest, cut) {
  n = 0
  while (length(line) > 0) {
    rest = substr(line, 2)
    if (match(rest, /[IWEDN] \[[0-9]/)) {
      cut = RSTART + 1
      out[++n] = substr(line, 1, cut - 1)
      line = substr(line, cut)
    } else { out[++n] = line; break }
  }
  return n
}
# Drop the logger name so the message itself starts at a fixed column. Only a
# dotted namespace or an NWNX_* plugin counts as a logger -- that keeps message
# tags like [FORGE] and [Bestiary], which are ours and are the whole point.
function strip_logger(b,   tok) {
  if (match(b, /^\[[A-Za-z][A-Za-z0-9_.]*\] /)) {
    tok = substr(b, 2, RLENGTH - 3)
    if (tok ~ /\./ || tok ~ /^NWNX/) {
      b = substr(b, RLENGTH + 1)
      sub(/^\[[A-Za-z_]+\.cpp:[0-9]+\] /, "", b)   # NWNX file:line
    }
  }
  sub(/^\(Server\) /, "", b)
  return b
}
function render(sev, tm, msg,   mark, txt) {
  mark = (sev == "W" || sev == "E") ? sev : " "
  txt = tm " " mark BODYSEP msg
  if (sev == "W" || sev == "E") return PREFIX " " paint("1;31", txt)
  return PREFIX " " paint(COLORCODE, txt)
}
{
  nrec = unglue($0, rec)
  for (r = 1; r <= nrec; r++) {
    line = rec[r]
    sub(/^\.+/, "", line)                    # module-load progress dots
    if (line ~ /^[ \t]*$/) continue

    sev = ""; date = ""; tm = ""; body = line
    if (match(line, /^[IWEDN] \[/)) {   # I=info N=notice W=warn E=error D=debug
      sev = substr(line, 1, 1)
      body = substr(line, 3)
      if (match(body, /^\[[0-9][0-9][0-9][0-9]\/[0-9][0-9]\/[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]\.[0-9][0-9][0-9]\] /)) {
        date = substr(body, 2, 10)
        tm   = substr(body, 13, 8)
        body = substr(body, RLENGTH + 1)
      } else if (match(body, /^\[[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\] /)) {
        tm   = substr(body, 2, 8)
        body = substr(body, RLENGTH + 1)
      }
    }

    # Carry the date forward from the last dated line (NWNX lines have none);
    # a line with no clock at all inherits the previous line entirely, which is
    # what keeps "Server: Loading..." sitting with its neighbours.
    #
    # This has to happen BEFORE the filter: the engine boot sequence alternates
    # timestamped NWNX lines (nearly all noise) with bare nwserver lines (the
    # ones worth keeping), so dropping a line must still advance the clock or
    # every kept boot line inherits a timestamp from minutes later.
    if (date != "") curdate = date
    if (tm == "") tm = curtime; else curtime = tm
    date = (date != "") ? date : curdate
    # First clock seen anywhere in this backlog, dropped lines included -- the
    # END block back-fills the boot lines that print before it with this.
    if (date != "" && firstdate == "") firstdate = date
    if (tm != "" && firsttime == "") firsttime = tm

    # Match the blocklist against BOTH the logger-prefixed body and the bare
    # message. Some patterns key off the logger ("[NWNX_Damage] ..."), others
    # anchor on the message itself ("^Prelinking ") -- and the engine is
    # inconsistent about which of its boot lines carry a logger at all.
    msg = strip_logger(body)
    drop = (body ~ NOISE || msg ~ NOISE) && sev != "W" && sev != "E"
    if (drop == KEEP) continue

    if (MODE == "sort") {
      n++; D[n] = date; T[n] = tm; S[n] = sev; B[n] = msg
    } else {
      # A live line with no clock of its own and nothing to inherit yet (the
      # first few boot lines) is stamped with the moment we attached -- which is
      # within a second or two of the truth, and beats printing "--:--:--".
      print render(sev, (tm == "" ? START : tm), msg)
      fflush()
    }
  }
}
END {
  if (MODE != "sort") exit
  if (firstdate == "") firstdate = TODAY
  if (firsttime == "") firsttime = "00:00:00"
  for (i = 1; i <= n; i++) {
    # Lines before the first dated/timed line in this backlog: back-fill, so
    # they sort at the head of this realm rather than at the head of all time.
    d = (D[i] != "") ? D[i] : firstdate
    t = (T[i] != "") ? T[i] : firsttime
    printf "%s %s\t%s\n", d, t, render(S[i], t, B[i])
  }
}
'

tidy() {  # $1=mode(sort|live) $2=painted prefix $3=colour code
  local keep=1
  [[ $MODE == dropped ]] && keep=0
  awk -v MODE="$1" -v PREFIX="$2" -v COLORCODE="$3" \
      -v COLORON="$([[ $COLOR == never ]] && echo 0 || echo 1)" \
      -v NOISE="$NOISE_RE_AWK" -v KEEP="$keep" \
      -v TODAY="$(date +%Y/%m/%d)" -v START="$(date +%H:%M:%S)" -v BODYSEP=' ' \
      "$TIDY_AWK"
}

# ------------------------------------------------------------------ banner ---
echo "=== Homer's LotR — live server monitor (all realms) ==="
for i in "${!TAGS[@]}"; do
  printf '  %s  %-18s %s\n' \
    "$(paint "${COLORS[$i]}" "$(printf '[%-*s]' "$TAGW" "${TAGS[$i]}")" bold)" \
    "${LABELS[$i]}" "${CONTAINERS[$i]}"
done
# Storage line. "Server is running" is a misleading green light if the realm is
# running against an empty directory because its SSD bind mount is missing, so
# say so here rather than leaving it to be inferred from the log. Realms
# deliberately left on the HDD report n/a, not a fault -- see
# bin/season-volumes.sh for the fstab-declared rule that distinguishes them.
if [[ -r $PROJECT_ROOT/bin/season-volumes.sh ]]; then
  # shellcheck source=bin/season-volumes.sh
  . "$PROJECT_ROOT/bin/season-volumes.sh"
  for i in "${!TAGS[@]}"; do
    bad=$(season_volumes_status "${HOMEDIRS[$i]}" "${RUNDIRS[$i]}" | grep -cve '^\(ok\|n/a\)' || true)
    if (( bad )); then
      printf '  %s  %s\n' \
        "$(paint 31 "$(printf '[%-*s]' "$TAGW" "${TAGS[$i]}")" bold)" \
        "$(paint 31 'STORAGE FAULT — SSD bind mount missing; this realm is NOT on its real data' bold)"
    fi
  done
fi
if (( RAW )); then
  echo "(Raw mode: no filtering, no time merge.)"
elif [[ $MODE == dropped ]]; then
  echo "(Showing ONLY filtered-out lines — blocklist audit mode.)"
else
  echo "(Boilerplate filtered; --raw for everything, --show-dropped to audit.)"
fi
echo "(Read-only. Ctrl+C / closing this window stops watching, NOT the servers.)"
echo

# ------------------------------------------------------------------ streams ---
# Ctrl+C / closing the window should tear down every child. Without this the
# reconnect loops below would outlive the shell and keep `podman logs` running.
#
# Kill the followers by PID rather than `kill 0`: the process group also holds
# whatever the caller piped us into, and blowing that away turns a harmless
# `watch-all-servers | grep join` into a terminated pipeline. Each follower is a
# subshell, so signal its whole group (-PID) to reach the podman child too.
FOLLOWERS=()
WORKDIR=$(mktemp -d -t watch-all-servers.XXXXXX)
cleanup() {
  trap - INT TERM EXIT
  echo
  echo "Stopped watching (servers still running)."
  for pid in "${FOLLOWERS[@]:-}"; do
    [[ -n $pid ]] || continue
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null
  done
  [[ -n ${WORKDIR:-} && -d $WORKDIR ]] && rm -rf "$WORKDIR"
  exit 0
}
trap cleanup INT TERM EXIT

prefix_for() { paint "${COLORS[$1]}" "$(printf '[%-*s]' "$TAGW" "${TAGS[$1]}")" bold; }

# ---------------------------------------------------------- phase A: backlog ---
# Collect every realm's history FIRST, then merge-sort it into one chronological
# stream. Done any other way (the followers each dumping their own --tail) the
# backlogs race and interleave by kernel scheduling, which is what made the
# window open with 03:12 above 07:37 above 03:12.
#
# --tail counts lines you SEE, across all realms -- not raw lines per realm.
# The blocklist throws away ~95% of the stream, so asking podman for N and then
# filtering leaves about N/20: `--tail 100` used to open on 48 lines while the
# editor's /monitor page showed 141 of the same history, which read as the
# terminal monitor "missing" things. So over-fetch, filter, then trim -- the
# same 12x-capped-at-6000 arithmetic as server_log_tail_all() in
# bin/roadmap-editor.py. Keep the two in step; they are meant to open on the
# identical view.
if (( ! RAW )); then
  fetch=$(( TAIL * 12 )); (( fetch > 6000 )) && fetch=6000

  for i in "${!TAGS[@]}"; do
    ( podman logs --tail "$fetch" "${CONTAINERS[$i]}" > "$WORKDIR/$i.raw" 2>&1 ) &
  done
  wait

  for i in "${!TAGS[@]}"; do
    [[ -s "$WORKDIR/$i.raw" ]] || continue
    tidy sort "$(prefix_for "$i")" "${COLORS[$i]}" < "$WORKDIR/$i.raw" > "$WORKDIR/$i.keyed"
  done
  # -s keeps same-timestamp lines in the order the container printed them.
  cat "$WORKDIR"/*.keyed 2>/dev/null | sort -s -t$'\t' -k1,1 | tail -n "$TAIL" | cut -f2-
  echo "$(paint 90 "--- live ---")"
fi

# ------------------------------------------------------------- phase B: live ---
# One follower per realm. Each mirrors bin/watch-server's reconnect loop: a
# reboot-on-empty or scheduled restart destroys the container and `podman run
# --rm` makes a fresh one under the same name, so `podman logs -f` exits. Wait
# for the new container and re-attach rather than dying -- and one realm
# restarting must never take the other realms' streams down with it.
follow() {  # $1=tag $2=container $3=color
  local tag=$1 container=$2 color=$3 prefix waiting=0 id lastid="" backlog
  prefix=$(paint "$color" "$(printf '[%-*s]' "$TAGW" "$tag")" bold)

  emit() { printf '%s %s\n' "$prefix" "$(paint "$color" "$1")"; }

  # Phase A already printed the history, so the first attach must not repeat it.
  # On a later attach the answer depends on WHY the stream ended: a new
  # container ID means the server restarted and its whole (now short) log is the
  # startup sequence worth seeing; the same ID means the stream merely dropped
  # and re-printing its history would duplicate what is already on screen.
  backlog=0
  (( RAW )) && backlog=$TAIL

  while true; do
    if ! podman container exists "$container" 2>/dev/null; then
      # After a reboot the boot service takes ~40s to load the module. Say so
      # once, then wait quietly instead of scrolling the other realms away.
      (( waiting )) || emit "waiting for container $container to come up..."
      waiting=1
      sleep 2
      continue
    fi
    waiting=0

    id=$(podman inspect -f '{{.Id}}' "$container" 2>/dev/null)
    if [[ -n $lastid && $id != "$lastid" ]]; then
      backlog=all          # fresh container: show it booting
    fi
    lastid=$id

    # Show recent history, then follow live. stdbuf keeps podman line-buffered:
    # without it the pipe into the prefixer below block-buffers and the stream
    # arrives in 4K bursts instead of live.
    if (( RAW )); then
      stdbuf -oL podman logs --tail "$backlog" -f "$container" 2>&1 \
        | while IFS= read -r line; do emit "$line"; done
    else
      stdbuf -oL podman logs --tail "$backlog" -f "$container" 2>&1 \
        | tidy live "$prefix" "$color"
    fi

    emit "--- container went away (restart?) — reconnecting... ---"
    backlog=0
    sleep 2
  done
}

# Job control gives each background follower its own process group, which is what
# makes the `kill -- -PID` in cleanup() reach the podman process inside it. Off
# by default in a non-interactive shell.
set -m

for i in "${!TAGS[@]}"; do
  follow "${TAGS[$i]}" "${CONTAINERS[$i]}" "${COLORS[$i]}" &
  FOLLOWERS+=("$!")
done

wait
