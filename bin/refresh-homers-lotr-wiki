#!/usr/bin/env bash
# Desktop-launcher target: regenerate the Homer's LotR static wiki only
# (skips the slow .mod unpack step). Use this when only wiki-generation
# code or templates have changed and the unpacked tree is already current.
# Pauses at the end so failure output stays visible when launched from the
# GNOME app grid (no parent shell to read).
#
# It also regenerates the public roadmap page from roadmap.yaml and pushes the
# same data to the in-game Recent Updates sign's campaign DB, so the daily cycle
# carries the backlog with it (see the "roadmap, first" block below).
#
# With --publish: run non-interactively and, after a successful regen, commit
# the regenerated wiki (docs/ + docs.manual/Roadmap.html) and push it. Used by
# the post-boot systemd service (nwn-season-wiki-publish@.service) so the daily
# reboot republishes the FULL site — including creature-index/detail kill
# counts, which the serve-loop activity refresh does not touch.

set -o pipefail

PUBLISH=0
for arg in "$@"; do
  case "$arg" in
    --publish) PUBLISH=1 ;;
    *) echo "error: unknown arg: $arg" >&2; exit 2 ;;
  esac
done

# Season-relocatable: derive the project from this script's own location, so a
# copy of the repo at any path regenerates its OWN wiki (season-cutover-prereqs
# item 4). nwn_manager stays absolute — it is genuinely one shared checkout.
PROJECT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
NWN_MANAGER_BIN=/var/home/james/GIT/nwn_manager/bin

export PATH="$HOME/.nimble/bin:$NWN_MANAGER_BIN:$PATH"

pause() { [[ $PUBLISH -eq 1 ]] || read -rp "Press Enter to close..."; }

cd "$PROJECT" || { echo "missing project: $PROJECT"; pause; exit 1; }

# Export TZ from server.env so nwn-wiki labels the activity charts with the
# correct timezone (e.g. America/Chicago → "GMT-5" / "GMT-4" per DST).
# shellcheck disable=SC1091
[[ -f "$PROJECT/server.env" ]] && . "$PROJECT/server.env" && export TZ

# The server runs in a container: --log-dir holds the host-readable logs, but the
# campaign SQLite DBs (incl. bestiarydb.sqlite3) live under NWN_HOME_DIR/database
# (the host path bound to the container's database/). Point --db-dir there so the
# bestiary catalogue is seeded and kill stats are read. NWN_HOME_DIR comes from
# server.env (sourced above); fall back to the standard NWN user dir.
DB_DIR="${NWN_HOME_DIR:-$HOME/.local/share/Neverwinter Nights}/database"
# The server vault, for the Players section (character pages, leaderboards and
# the Hall of Fame). Admin/DM characters are excluded by the generator.
VAULT_DIR="${NWN_HOME_DIR:-$HOME/.local/share/Neverwinter Nights}/servervault"

# Both from server.env: SEASON_WIKI_URL is the apex for the live season and
# season<N>.homerslotr.com otherwise; NWN_RUN_DIR is this instance's run dir,
# which holds the host-readable server logs the activity charts are built from.
# Fallbacks keep the script working against a repo with no season block yet.
BASE_URL="${SEASON_WIKI_URL:-https://homerslotr.com/}"

# Who's Online. This realm does not publish a roster (SEASON_STATUS_PUSH_URL is
# empty here and its worker has no KV binding), so the page reads the LIVE
# season's endpoint -- what a player wants from the TEST wiki is who is on the
# real server. That is a cross-origin read, which the live worker allows on GET.
ONLINE_API="${SEASON_LIVE_WIKI_URL:-https://homerslotr.com/}api/online"
LOG_DIR="${NWN_RUN_DIR:-$HOME/.local/state/nwnxee-homer}"

# Combat-stat dials, from server.env so the wiki's derived stats match what the
# running server actually enforces (nwn-wiki defaults to the stock 40 / +12):
#   NWN_MAXLEVEL          — server level cap; nwn-wiki clamps a creature's total
#                           class levels to it when summing BAB, so a 100+ HD
#                           boss stops accruing BAB past the cap. Unset means the
#                           container's own default of 40 (season 1); season 2
#                           sets 60, which lets a multiclass boss's later classes
#                           keep contributing where a 40 cap cut them off.
#   NWN_MAX_ABILITY_BONUS — cap on the ability bonus a single item may grant
#                           (settings.tml max-ability-bonus; this module runs 24).
MAX_LEVEL="${NWN_MAXLEVEL:-40}"
MAX_ABILITY_BONUS="${NWN_MAX_ABILITY_BONUS:-12}"

# ------------------------------------------------------- roadmap, first ------
# The public roadmap page and the in-game Recent Updates sign are both built
# from roadmap.yaml, and until this ran here BOTH were manual: gen-roadmap.py by
# hand and the sign only from the editor's "Publish to Wiki & DB" button. So
# anything shipped by an agent or a hand-edit left the website and the sign
# stale while the wiki around them was republished nightly.
#
# gen-roadmap.py must run BEFORE `nwn-manager wiki`, because the wiki build is
# what folds docs.manual/Roadmap.html into docs/ — including the @menu directive
# that decides which nav dropdown the page lands in.
#
# Neither step may take the wiki down with it: a roadmap.yaml that fails
# validation is a roadmap problem, not a reason to skip the nightly republish of
# 287 areas. Both warn and continue.
if python3 "$PROJECT/bin/gen-roadmap.py" --check >/dev/null 2>&1; then
  # Print the generator's own line: on a season realm it SKIPS (only the dev
  # realm renders the page - the roadmap editor's Publish copies it into the
  # live realm's docs/ directly), and claiming "regenerated" there would be a
  # lie that hides the skip.
  if roadmap_out=$(python3 "$PROJECT/bin/gen-roadmap.py" 2>&1); then
    echo "[roadmap] ${roadmap_out}"
  else
    echo "[roadmap] warn: gen-roadmap.py failed; publishing the existing page" >&2
  fi
else
  echo "[roadmap] warn: roadmap.yaml FAILED validation — leaving Roadmap.html as it is" >&2
  python3 "$PROJECT/bin/gen-roadmap.py" --check 2>&1 | sed 's/^/[roadmap]   /' >&2
fi

if python3 "$PROJECT/bin/publish-roadmap-db.py"; then
  echo "[roadmap] in-game Recent Updates sign refreshed"
else
  echo "[roadmap] warn: could not refresh the in-game sign DB" >&2
fi
echo

nwn-manager wiki \
  --base-url "$BASE_URL" \
  --exclude-conv-option "[Admin Options]" \
  --exclude-conv-option "[Options of the Homeless]" \
  --log-dir "$LOG_DIR" \
  --db-dir "$DB_DIR" \
  --2da-dir "$PROJECT/hak_2da" \
  --max-character-level "$MAX_LEVEL" \
  --max-ability-bonus "$MAX_ABILITY_BONUS" \
  --vault-dir "$VAULT_DIR" \
  --online-api "$ONLINE_API" \
  --path-from thewelloferu
status=$?

echo
if [[ $status -ne 0 ]]; then
  echo "[FAILED] exit $status"
  echo
  pause
  exit "$status"
fi
echo "[done] wiki regenerated → $PROJECT/docs/index.html"

# ----------------------------------------------------------------- publish ---
if [[ $PUBLISH -eq 1 ]]; then
  # Stage the regenerated site. docs/ is the published wiki; docs.manual/Roadmap.html
  # is its git-tracked SOURCE, regenerated above, so it has to travel with it or
  # the next run rewrites it again from a working tree that never settles. These
  # two paths are the ONLY ones this automated publish may commit — the pathspec
  # is repeated on the commit so unrelated work in the tree (or anything another
  # process has already staged in the index) can never be swept into the republish.
  PUBPATHS=(docs docs.manual/Roadmap.html)
  git -C "$PROJECT" add -A -- "${PUBPATHS[@]}"

  if git -C "$PROJECT" diff --cached --quiet -- "${PUBPATHS[@]}"; then
    echo "[publish] no wiki changes to commit"
  else
    msg="Full wiki republish (kill counts + all pages): $(date '+%Y-%m-%d %H:%M')"
    if ! git -C "$PROJECT" commit -q -m "$msg" -- "${PUBPATHS[@]}"; then
      echo "[publish] warn: commit failed" >&2
    else
      # Push with retries — the network may still be coming up just after boot.
      pushed=0
      for attempt in 1 2 3 4 5; do
        git -C "$PROJECT" pull --rebase --quiet 2>/dev/null || true
        if git -C "$PROJECT" push --quiet; then pushed=1; break; fi
        echo "[publish] push attempt $attempt failed; retrying in 30s..." >&2
        sleep 30
      done
      [[ $pushed -eq 1 ]] && echo "[publish] committed and pushed: $msg" \
                          || echo "[publish] warn: could not push after retries; commit is local" >&2
    fi
  fi
fi

echo
pause
