#!/usr/bin/env bash
# empty-restart-handler — invoked by homers-lotr-empty-restart.service when the
# Anvil plugin drops the `restart-server` flag after a reboot-on-empty shutdown.
#
# Runs in the window *after* the server process has exited (clean shutdown) and
# *before* it comes back: it optionally republishes NWSync, then restarts the
# server user service, which relaunches bin/serve onto the current (freshly
# deployed) module.
#
# Two NWSync modes, armed by bin/reboot-on-empty:
#   reboot-on-empty-nwsync       rebuild the manifest here (the realm stays down
#                                for it; see NWSYNC_TIMES below for real runs).
#                                The file's CONTENT is the mode: "force" runs
#                                refresh-nwsync --force (every blob rewritten,
#                                corruption recovery, roughly twice as long),
#                                empty runs the ordinary incremental rebuild.
#   reboot-on-empty-nwsync-copy  publish the manifest another realm already built
#                                (seconds). The file holds that realm's repo path.
# The copy is guarded and refuses if the two realms' haks do not match; if it
# refuses, this falls back to the full rebuild. Slow and correct beats fast and
# wrong: leaving a stale manifest while the haks on disk have changed is the
# client/server hak mismatch the whole publish step exists to prevent.
#
# Not meant to be run by hand — the systemd .path unit fires it. Reads
# NWN_RUN_DIR from ../server.env (the server's userdirectory / Anvil PluginData
# lives under NWN_RUN_DIR, not NWN_HOME_DIR).
set -uo pipefail

PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ENV_FILE="$PROJECT_ROOT/server.env"
LOCAL_ENV_FILE="$PROJECT_ROOT/server.env.local"
# shellcheck disable=SC1090
. "$ENV_FILE"
[[ -f $LOCAL_ENV_FILE ]] && . "$LOCAL_ENV_FILE"
: "${NWN_RUN_DIR:?server.env must define NWN_RUN_DIR}"

# shellcheck source=bin/season-unit.sh
. "$PROJECT_ROOT/bin/season-unit.sh"
PLUGIN_DATA="$(season_anvil_dir "$NWN_RUN_DIR")/PluginData" || exit 1
REQUEST_FILE="$PLUGIN_DATA/restart-server"
NWSYNC_FILE="$PLUGIN_DATA/reboot-on-empty-nwsync"
NWSYNC_COPY_FILE="$PLUGIN_DATA/reboot-on-empty-nwsync-copy"

# Consume the trigger flag first so the .path unit re-arms for next time and we
# never loop on a stale flag.
rm -f "$REQUEST_FILE"

echo "[empty-restart] reboot-on-empty triggered."

UNIT=$(season_server_unit "$PROJECT_ROOT")
if [[ -z ${UNIT:-} ]]; then
  # Without a unit name there is nothing to stop and nothing to start, and the
  # stop/start pair below would silently target "". Say so and let systemd's own
  # restart policy handle the server, rather than pretending we are in control.
  echo "[empty-restart] ERROR: could not resolve this season's server unit; leaving the server to systemd and skipping the NWSync step." >&2
  exit 1
fi

# HOLD THE SERVER DOWN UNTIL NWSYNC IS PUBLISHED.
#
# The server unit is Restart=on-failure and the clean shutdown does not reliably
# exit 0, so systemd brings the server back ON ITS OWN without waiting for
# anything here. Measured on the season 2 deploy of 2026-08-18: this handler
# started at 11:04:33 and the server was serving again at 11:05:04 - 31 seconds
# later, manifest still unpublished. For that window the realm ran new haks
# while clients were handed the old manifest, which is exactly the client/server
# mismatch this step exists to prevent. With the --nwsync rebuild instead of the
# copy that window is longer — 65 seconds when it was last measured (dev,
# 2026-09-17), and the duration of every run is recorded below.
#
# `stop` is what closes it: it marks the unit intentionally down, so the restart
# policy cannot race us. The trap guarantees the realm comes back even if the
# NWSync step dies or this script is killed - a season left offline is a far
# worse failure than a stale manifest.
NWSYNC_DONE=0
bring_server_back() {
  echo "[empty-restart] starting $UNIT..."
  systemctl --user start "$UNIT"
  (( NWSYNC_DONE )) || echo "[empty-restart] WARNING: server started WITHOUT a completed NWSync step - clients may be served a stale manifest. Check the log above." >&2
  echo "[empty-restart] done."
}
trap bring_server_back EXIT

echo "[empty-restart] holding $UNIT down until NWSync is settled..."
systemctl --user stop "$UNIT" || true

# Where the rebuild's duration is recorded. bin/publish-and-arm reads this to
# tell players how long the realm will be down, so the number they are shown is
# measured rather than guessed - the estimate shipped on 2026-09-17 said 20-30
# minutes for a rebuild that took 65 seconds, and nothing in the system would
# ever have corrected it. One line per rebuild: <iso> <realm> <mode> <seconds>.
NWSYNC_TIMES="${XDG_CACHE_HOME:-$HOME/.cache}/nwsync-rebuild-times.log"

# $1 (optional) is the armed mode: "force" adds refresh-nwsync --force. Anything
# else - including the empty string every pre-2026-09-17 arm file holds - is the
# ordinary incremental rebuild.
nwsync_rebuild() {
  local mode=${1:-}
  local extra=()
  local start elapsed
  if [[ $mode == force ]]; then
    extra=(--force)
    echo "[empty-restart] FORCE-rebuilding NWSync manifest before relaunch (every blob rewritten)..."
  else
    echo "[empty-restart] rebuilding NWSync manifest before relaunch..."
  fi
  start=$SECONDS
  if "$PROJECT_ROOT/bin/refresh-nwsync" --silent "${extra[@]}"; then
    elapsed=$((SECONDS - start))
    echo "[empty-restart] NWSync manifest rebuilt in ${elapsed}s."
    # Best effort: a full realm must never fail to come back because a cache
    # file could not be written.
    printf '%s %s %s %s\n' "$(date -Is)" "$(basename "$PROJECT_ROOT")" \
           "${mode:-normal}" "$elapsed" >> "$NWSYNC_TIMES" 2>/dev/null || true
  else
    echo "[empty-restart] WARNING: refresh-nwsync failed; restarting server anyway." >&2
  fi
}

if [[ -f $NWSYNC_COPY_FILE ]]; then
  SRC=$(cat "$NWSYNC_COPY_FILE")
  rm -f "$NWSYNC_COPY_FILE"
  echo "[empty-restart] publishing NWSync manifest copied from $SRC ..."
  if [[ -x $PROJECT_ROOT/bin/nwsync-copy-from ]] \
     && "$PROJECT_ROOT/bin/nwsync-copy-from" "$SRC"; then
    echo "[empty-restart] NWSync manifest published by copy."
  else
    echo "[empty-restart] WARNING: manifest copy refused or failed — falling back to a full rebuild." >&2
    nwsync_rebuild
  fi
elif [[ -f $NWSYNC_FILE ]]; then
  NWSYNC_MODE=$(cat "$NWSYNC_FILE" 2>/dev/null || true)
  rm -f "$NWSYNC_FILE"
  nwsync_rebuild "$NWSYNC_MODE"
fi
NWSYNC_DONE=1

# The server comes back in the EXIT trap above, so it is started on every path
# out of this script - including a failure in the NWSync step. UNIT is resolved
# at the top by season_server_unit: with several seasons running, a hard-coded
# unit name here would bounce the wrong server.
