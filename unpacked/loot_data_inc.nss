// Lowest ladder step of affix nAffix at loot level nLvl.
int LootD_AffixLo(int nAffix, int nLvl)
{
    switch (nAffix)
    {
    case 0:
        if (nLvl <= 1) return 0;
        if (nLvl <= 60) return 0 + (6 * (nLvl - 1)) / 59;
        return 6;
