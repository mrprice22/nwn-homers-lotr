// Build item property nType from a subtype row and a cost-table row.  One case per
// loot_model.SUPPORTED_IP entry; anything else returns an invalid property.
itemproperty Loot_MakeIP(int nType, int nSub, int nCost)
{
    itemproperty ip;
    switch (nType)
    {
        case 0: ip = ItemPropertyAbilityBonus(nSub, nCost); break; // Ability Bonus
        case 1: ip = ItemPropertyACBonus(nCost); break; // AC Bonus
        case 6: ip = ItemPropertyEnhancementBonus(nCost); break; // Enhancement Bonus
        case 13: ip = ItemPropertyBonusLevelSpell(nSub, nCost); break; // Bonus Spell Slot
        case 16: ip = ItemPropertyDamageBonus(nSub, nCost); break; // Damage Bonus
        case 20: ip = ItemPropertyDamageImmunity(nSub, nCost); break; // Damage Immunity
        case 22: ip = ItemPropertyDamageReduction(nSub, nCost); break; // Damage Reduction
        case 23: ip = ItemPropertyDamageResistance(nSub, nCost); break; // Damage Resistance
        case 24: ip = ItemPropertyDamageVulnerability(nSub, nCost); break; // Damage Vulnerability
        case 26: ip = ItemPropertyDarkvision(); break; // Darkvision
        case 27: ip = ItemPropertyDecreaseAbility(nSub, nCost); break; // Decreased Ability
        case 28: ip = ItemPropertyDecreaseAC(nSub, nCost); break; // Decreased AC
        case 29: ip = ItemPropertyDecreaseSkill(nSub, nCost); break; // Decreased Skill
        case 37: ip = ItemPropertyImmunityMisc(nSub); break; // Immunity: Misc
        case 38: ip = ItemPropertyImprovedEvasion(); break; // Improved Evasion
        case 39: ip = ItemPropertyBonusSpellResistance(nCost); break; // Spell Resistance
        case 40: ip = ItemPropertyBonusSavingThrowVsX(nSub, nCost); break; // Saving Throw Bonus
        case 41: ip = ItemPropertyBonusSavingThrow(nSub, nCost); break; // Saving Throw Bonus: Specific
        case 43: ip = ItemPropertyKeen(); break; // Keen
        case 45: ip = ItemPropertyMaxRangeStrengthMod(nCost); break; // Mighty
        case 49: ip = ItemPropertyReducedSavingThrowVsX(nSub, nCost); break; // Decreased Saving Throws
        case 50: ip = ItemPropertyReducedSavingThrow(nSub, nCost); break; // Decreased Saving Throws: Specific
        case 51: ip = ItemPropertyRegeneration(nCost); break; // Regeneration
        case 52: ip = ItemPropertySkillBonus(nSub, nCost); break; // Skill Bonus
        case 56: ip = ItemPropertyAttackBonus(nCost); break; // Attack Bonus
        case 60: ip = ItemPropertyAttackPenalty(nCost); break; // Decreased Attack
        case 67: ip = ItemPropertyVampiricRegeneration(nCost); break; // Vampiric Regeneration
        case 71: ip = ItemPropertyTrueSeeing(); break; // True Seeing
        case 74: ip = ItemPropertyMassiveCritical(nCost); break; // Massive Criticals
        case 75: ip = ItemPropertyFreeAction(); break; // Freedom of Movement
        case 84: ip = ItemPropertyArcaneSpellFailure(nCost); break; // Arcane Spell Failure
    }
    return ip;
}
