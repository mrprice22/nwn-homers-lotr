        return 4;
    case 60:
        if (nLvl <= 1) return 1;
        if (nLvl <= 60) return 1 + (3 * (nLvl - 1)) / 59;
        return 4;
    case 61:
        if (nLvl <= 1) return 1;
        if (nLvl <= 60) return 1 + (3 * (nLvl - 1)) / 59;
        return 4;
    case 62:
        if (nLvl <= 1) return 1;
        if (nLvl <= 60) return 1 + (3 * (nLvl - 1)) / 59;
        return 4;
    case 63:
        if (nLvl <= 1) return 0;
        if (nLvl <= 60) return 0 + (2 * (nLvl - 1)) / 59;
        return 2;
    case 64:
        if (nLvl <= 1) return 0;
        if (nLvl <= 60) return 0 + (2 * (nLvl - 1)) / 59;
        return 2;
    case 65:
        if (nLvl <= 1) return 0;
        if (nLvl <= 60) return 0 + (2 * (nLvl - 1)) / 59;
        return 2;
    case 66:
        if (nLvl <= 1) return 0;
        if (nLvl <= 60) return 0 + (2 * (nLvl - 1)) / 59;
        return 2;
    case 67:
        if (nLvl <= 1) return 1;
        if (nLvl <= 60) return 1 + (3 * (nLvl - 1)) / 59;
        return 4;
    }
    return 0;
}

