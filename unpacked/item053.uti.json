  "DescIdentified": {
    "type": "cexolocstring",
    "value": {
      "0": "Commanding respect from the smallest of folk to the eldest of kings, this wood anchors the spirit against the tides of malice. It offers a shield of unseen iron, turning aside the malice of lesser sorceries as if they were mere autumn leaves."
    }
