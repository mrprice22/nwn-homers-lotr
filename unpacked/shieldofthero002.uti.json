  "Description": {
    "type": "cexolocstring",
    "value": {
      "0": "Etched lines and old scars mark the face of this battered heirloom, showing years of defense against the tide of shadow. It bears a reassuring steadiness in the hand, balanced by a master's craft that defies its weathered surface."
    }
