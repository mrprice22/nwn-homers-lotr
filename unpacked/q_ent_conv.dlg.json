        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*A vast old tree, bark grown over bark, moss to the shoulder. For a moment you would swear there was a face in the knots of it -- eyes shut, mouth shut, sunk deep in a sleep that has lasted longer than your people have had names. Nothing you say reaches it.*"
          }
        }
      },
      {
        "__struct_id": 5,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
