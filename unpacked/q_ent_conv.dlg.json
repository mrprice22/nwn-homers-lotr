          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*The bark has closed over. Somewhere far inside the trunk there is a slow, sleeping creak, and nothing else.* Hoom... no. Not again so soon. Come back in <CUSTOM6390>, and bring more patience with you."
          }
        }
      },
      {
        "__struct_id": 4,
        "Animation": {
          "type": "dword",
