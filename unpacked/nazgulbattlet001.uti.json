  "DescIdentified": {
    "type": "cexolocstring",
    "value": {
      "0": "This garment served the dark servants of the Temple of Nazgul, shielding them against both steel and the elements. It holds a grim, suffocating weight that sustains the life of the one who dons it, even as it permits the most profound of mysteries to be commanded."
    }
