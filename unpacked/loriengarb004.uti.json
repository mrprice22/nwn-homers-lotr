  "Description": {
    "type": "cexolocstring",
    "value": {
      "0": "Linen and silk weave together in muted tones, draping over the shoulders with a fluid grace. The fabric remains cool against the skin, moving with the wearer as if woven from the very shadows of the forest."
    }
