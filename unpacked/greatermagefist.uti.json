  "DescIdentified": {
    "type": "cexolocstring",
    "value": {
      "0": "The arcane arts flow through these gauntlets with effortless clarity, anchoring the mind against the chaos of high magic. One who dons them finds the most complex enchantments yielding to a single, resolute will."
    }
