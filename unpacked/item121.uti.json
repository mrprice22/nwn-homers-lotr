  "DescIdentified": {
    "type": "cexolocstring",
    "value": {
      "0": "The one who binds this leather to their waist finds their spirit fortified against the shadows. It grants a sharp clarity of mind and a mastery over the hidden mechanisms of the world. Even in the deepest pits of Dol Guldur, it offers a resilience that mends the body's wear."
    }
  },
  "Description": {
    "type": "cexolocstring",
    "value": {
      "0": "Coarse black leather wraps around the waist, bound by interlocking plates of darkened iron. The material is stiff and cold, smelling of old soot and scorched earth."
    }
