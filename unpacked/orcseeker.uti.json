  "DescIdentified": {
    "type": "cexolocstring",
    "value": {
      "0": "A grim chill settles over the mind of the one who wields this jagged iron. It carries a terrible potency, capable of rending flesh and spirit alike with a devastating, multi-faceted fury. This relic of the deep mines leaves even the most resolute foe reeling in a haze of madness."
    }
  },
  "Description": {
    "type": "cexolocstring",
    "value": {
