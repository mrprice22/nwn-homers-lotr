// Module items whose socket count is not the eligible default, packed by the
// resref's first character into parts of at most 900 characters: '|<resref>:<n>|...'.
// Gem_SocketMax searches them with FindSubString; an empty string ends a character's parts.
const int LOOTD_SOCK_EXCEPTIONS = 481;
string LootD_SockList(string sFirst, int nPart)
{
    if (sFirst == "0")
    {
        if (nPart == 0) return "|015:2|028:2|030:2|033:2|048:2|051:2|052:2|054:2|059:2|064:2|065:2|066:2|067:2|068:2|071:2|073:2|074:2|075:2|081:2|088:2|089:2|090:2|091:2|093:2|095:2|096:2|097:2|";
        return "";
    }
    if (sFirst == "1")
    {
        if (nPart == 0) return "|101:2|102:2|103:2|104:2|105:2|109:2|110:2|112:2|115:2|122:2|125:2|127:2|131:2|132:2|136:2|137:2|141:2|142:2|143:2|144:2|146:2|147:2|148:2|149:2|150:2|151:2|152:2|";
        return "";
    }
    if (sFirst == "a")
    {
        if (nPart == 0) return "|aarcl015:2|adamantitesma001:2|ancientbow009:2|ancienthamme005:2|ancientmace005:2|ancientsword005:2|armofadam:2|armorofinvuln002:2|armorofinvuln003:2|armorofinvulnera:2|armourofelendil:2|avenger:2|avenger002:2|axeofthebrute001:2|axeofthewarrior2:2|";
        return "";
    }
    if (sFirst == "b")
    {
        if (nPart == 0) return "|badbrains:2|badbrains002:2|balrogskin:2|banditleather:2|basherofthemutan:2|basiliskclaw006:2|basiliskhard001:2|basiliskskin:2|basilisktail006:2|basiliskvisa002:2|bastardofthehobb:2|bastardswordofth:2|battleplateof011:2|beltofdarkwardin:2|beltofgreatne002:2|beltofgreatness:2|beltofpower002:2|beltofsorcerery:2|bilbosdefense:2|blackmist4:2|bladebuckle001:2|bladeofhareth:2|bladeofthedan001:2|bladeofthedancer:2|bladeoftheelf:2|bladesofthedeath:2|boneshard:2|bootsoflord011:2|bootsofquicke001:2|bootsofthedrider:2|bootsofthemighty:2|bossphysimmunear:2|branchofrivendel:2|";
        return "";
    }
    if (sFirst == "c")
    {
        if (nPart == 0) return "|carapaceofcha002:2|carapiceofshe001:2|carapiceofshello:2|celestialfury:2|cg_amu_cleric:2|cg_amu_druid:2|cg_amu_sorc:2|cg_amu_wiz:2|chainofithilien:2|chanceguard:2|chosenkama:2|cloth005:2|cloth012:2|cloth027:2|cloth032:2|cloth033:2|cloth034:2|crossbowofthedwa:2|crownofweathe002:2|cursedguantle002:2|cursedguantle003:2|cursedguantle004:2|cursedguantlets:2|cursedoneshel002:2|cursedplate:2|cursedplate002:2|cus_shiftertu001:2|cus_shiftertu002:2|";
        return "";
    }
