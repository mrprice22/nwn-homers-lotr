// Gem tier floor at loot level nLvl (gems.json level_bands).
int LootD_GemBandFloor(int nLvl)
{
    if (nLvl >= 45) return 2;
    if (nLvl >= 25) return 1;
    if (nLvl >= 10) return 0;
    if (nLvl >= 1) return 0;
    return 0;
}

// Gem tier ceiling at loot level nLvl (gems.json level_bands).
int LootD_GemBandCeil(int nLvl)
{
    if (nLvl >= 45) return 4;
    if (nLvl >= 25) return 3;
    if (nLvl >= 10) return 2;
    if (nLvl >= 1) return 1;
    return 0;
}

