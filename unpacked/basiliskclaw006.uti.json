  "Description": {
    "type": "cexolocstring",
    "value": {
      "0": "Coarse, greyish scales form this gauntlet, curved into sharp points that grip with a predatory steadiness. The dried skin remains stiff and cold, smelling of old earth and stagnant water."
    }
