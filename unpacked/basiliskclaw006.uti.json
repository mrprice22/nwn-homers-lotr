  "DescIdentified": {
    "type": "cexolocstring",
    "value": {
      "0": "Those struck by the claw find their vision stolen and their limbs heavy as stone. These gauntlets carry the biting chill and searing rot of the beast that birthed them. Only a few such relics remain from the depths of the Mirkwood crypts.",
      "id": 67475
    }
