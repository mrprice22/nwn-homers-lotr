# Homer's LOTR VEL v3 — dedicated server config.
#
# Sourced by bin/serve. Edit values here, not in the launcher script.
# All NWNX:EE plugins skip by default; flip to "n" to enable.

# ---------------------------------------------------------------- container --
# Anvil image = nwnxee/unified + bundled Anvil .NET host + NWNX_DotNET preconfigured.
# Tag matches our NWN build (8193.37) and the pinned NWN.Anvil NuGet (8193.37.3).
# The Dungeon Solitaire C# plugin (csharp/) needs this; the plain nwnxee/unified
# image does NOT ship Anvil, so the plugin silently never loads. To run without
# the C# plugin, swap back to "docker.io/nwnxee/unified:latest".
NWN_IMAGE="docker.io/nwndotnet/anvil:8193.37.3"
NWN_CONTAINER_NAME="nwnxee-homer-dev"
TZ=America/Chicago

# Persistent runtime dir on the host. Survives reboots; container's /nwn/run
# is bind-mounted here so logs, the SQLite campaign DB, NWSync state, etc.
# all live in this directory and are inspectable from the host.
NWN_RUN_DIR="$HOME/.local/state/nwnxee-homer-dev"

# Where the server reads modules / haks / tlk / servervault from.
NWN_HOME_DIR="$HOME/.local/share/Neverwinter Nights Dev"

# ---------------------------------------------------------------- gameplay ---
NWN_MODULE="Homer's LOTR DEV"
NWN_SERVERNAME="Homer's LOTR - DEV REALM (password required)"
NWN_PORT=5123
NWN_MAXCLIENTS=30
NWN_PUBLICSERVER=1       # 1 to advertise on the master server
NWN_SERVERVAULT=1        # server-side character storage (persistent-world characters)
NWN_DIFFICULTY=3
NWN_PVP=2
NWN_AUTOSAVEINTERVAL=0  # minutes; 0 disables
NWN_ELC=0
NWN_ILR=0
NWN_PAUSEANDPLAY=0
NWN_MAXHP=1             # always roll max HP on level up
# Engine level cap. This is the SERVER's own restriction, entirely separate from
# the NWNX MaxLevel plugin below - the container entrypoint passes it as
# `-maxlevel` (defaulting to 40), it is what the server browser advertises as the
# level range, and it is what refuses a login with "Invalid character - player
# login refused, character level disallowed by server restrictions". Both levers
# must say 60 or a level 41+ character is locked out of its own server; keep this
# in step with NWNX_MAXLEVEL_MAX. bin/serve also writes it into settings.tml's
# max-character-level, which the engine would otherwise regenerate as 40.
NWN_MAXLEVEL=60
NWN_STICKYMODES=1       # combat modes persist between combats
NWN_MAX_ABILITY_BONUS=24  # raised from default 12; patched into settings.tml by bin/serve

#Passwords (Set these in server.env.local instead -- not committed to GIT)
#NWN_PLAYERPASSWORD=""
#NWN_DMPASSWORD=""
#NWN_ADMINPASSWORD=""

# ---------------------------------------------------------------- NWNX -------
# Plugin set the module expects:
#   Creature, Player, Object, Administration, Util, Events, Effect, Damage,
#   MaxLevel, ELC.
#   (MaxLevel is the lever for the level 41-60 cap - see README "Levels 41-60".)
#   (Damage drives the Devastating Critical rework - unpacked/devcrit_atk.nss.
#    tests/check_devcrit.py fails the repack if this line and the include in
#    unpacked/ ever get out of step.)
# Core + ServerLogRedirector are always on.
NWNX_CREATURE_SKIP=n
NWNX_ADMINISTRATION_SKIP=n
NWNX_PLAYER_SKIP=n
NWNX_OBJECT_SKIP=n
NWNX_UTIL_SKIP=n
NWNX_EVENTS_SKIP=n
NWNX_EFFECT_SKIP=n
NWNX_DAMAGE_SKIP=n

# Levels 41-60. NWNX_MAXLEVEL_MAX is the cap itself; the plugin also needs
# NWNX_ELC loaded to bypass the engine's hardcoded level-40 restriction (its
# readme: "merely loading this plugin is sufficient", no configuration). Loading
# NWNX_ELC is NOT the same as turning on the server's own character validation
# -- NWN_ELC/NWN_ILR above stay 0, and nothing in unpacked/ subscribes to the
# NWNX ELC validation events, so no connecting character is re-validated.
# Do not also call NWNX_Administration_SetMaxLevel() from a script: two levers
# writing the same value is a conflict (unpacked/nwnx_admin.nss:173).
# The 41-60 XP table itself lives in hak_2da/exptable.2da and only exists in
# game once lotr_rules.hak is rebuilt (bin/build-lotr-rules-hak --install).
NWNX_MAXLEVEL_SKIP=n
NWNX_MAXLEVEL_MAX="$NWN_MAXLEVEL"   # one source of truth; see NWN_MAXLEVEL above
NWNX_ELC_SKIP=n
NWNX_TWEAKS_SKIP=n
NWNX_TWEAKS_CHARLIST_SORT_BY_LAST_PLAYED_DATE=true
NWNX_TWEAKS_CAN_USE_ITEMS_WHILE_POLYMORPHED=true
# Tweaks is env-var only (no NWScript API), so this comment IS the record of the
# chosen set. Audited 2026-07-27 against the plugin's full option list for
# levels 41-60 (roadmap ll-tweaks-audit); everything below stays OFF, listed so
# the next audit knows they were considered rather than missed:
#   ADD_PRESTIGECLASS_CASTER_LEVELS   would raise caster level for prestige
#     classes; 41-60 already keeps class caster level scaling, and this changes
#     1-40 balance too. A separate decision, not an epic-levels one.
#   RESIST_ENERGY_STACKS_WITH_EPIC_ENERGY_RESISTANCE, UNCAP_DAMAGE_RESISTANCE_
#     DAMAGE_FLAGS, PREVENT_ATTACK_BONUS_BYPASSING_REDUCTION   all push the
#     high-end damage/DR maths further; leave until 41-60 play is observed.
#   FIX_DISPEL_EFFECT_LEVELS   caster-level-sensitive; revisit if dispels
#     misbehave at 41+.
#   SEND_TLK_OVERRIDE_BEFORE_CHARGEN   only needed if the "Next Level" XP
#     display workaround (NWNX_Player_SetTlkOverride) is ever implemented.
#   CANUSEITEM_CHECK_ILR_FOR_HENCHMEN   moot: NWN_ILR=0.
# Nothing in the option list handles level/feat/XP grants themselves, so no
# Tweaks option is required for the level cap.

# .NET host for the Anvil plugin (Dungeon Solitaire, csharp/). Required — the
# default SKIP_ALL config would otherwise skip NWNX_DotNET and Anvil never boots.
# ANVIL_LOG_MODE=Redirect surfaces Anvil's log (look for "[DungeonSolitaire]
# wired ... lever") in logs.0/ and `podman logs nwnxee-homer`.
NWNX_DOTNET_SKIP=n
ANVIL_LOG_MODE=Redirect

# Daily scheduled-restart time (server-local HH:mm), read by the Anvil
# ServerRestartManager plugin. It broadcasts countdown warnings (60/30/15/10/5/1
# min), exports all characters, and shuts the server down at this time. The host
# root systemd timer (nwn-reboot.timer) reboots the machine a few minutes later;
# the server auto-starts on boot. Leave empty to disable in-game scheduling.
ANVIL_RESTART_DAILY=03:00

# Extra nwserver CLI args. -userdirectory is required (image default); -maxhp
# forces max HP on every level-up. Sticky combat modes has no CLI flag — see
# onmoduleload.nss for the NWNX_Administration approach if needed.
NWN_EXTRA_ARGS="-userdirectory /nwn/run"

# ---------------------------------------------------------------- NWSync -----
# bin/refresh-nwsync writes the manifest into NWNSYNC_REPO; bin/serve-nwsync
# runs an nginx container that serves it on NWNSYNC_PORT. nwserver itself
# only *advertises* NWNSYNC_PUBLIC_URL — clients fetch the bytes from nginx.
NWNSYNC_REPO="$HOME/.local/share/Neverwinter Nights Dev/nwsync/HomersLOTR-Dev"
NWNSYNC_PORT=8002
NWNSYNC_CONTAINER="nwnsync-nginx-dev"
NWNSYNC_IMAGE="docker.io/nginx:alpine"

# Public URL the master server hands to clients. Must be reachable from the
# *internet*, not just LAN — set in server.env.local with your WAN IP or
# DDNS hostname, e.g. "http://homer.example.com:8000". Leave unset to skip
# nwsync advertisement (clients then need CEP installed locally to join).
#NWNSYNC_PUBLIC_URL=""

# Forwarded into the nwnxee container so the game server announces the URL.
NWN_NWSYNCURL="${NWNSYNC_PUBLIC_URL:-}"
NWN_NWSYNCPUBLISHHAKS=0  # nginx serves the bytes; nwserver only advertises

# ---------------------------------------------------------------- season -----
# Identity of this environment in the season rotation. Every season-scoped value
# in the repo derives from this block — see season-cutover-guide.md and
# season-cutover-prereqs.md, and README.md "Season identity".
#
# SEASON_NUM + SEASON_ROLE are the only *authored* facts. The module name, server
# name, worker name and every in-game URL/sign are derived and written by
# `python3 bin/season-brand.py --apply`. Never hand-edit those; edit here instead.
SEASON_NUM=2
SEASON_ROLE=dev                             # live | test | dev | archive
#
# ROLE decides both branding (season-brand.py) and BEHAVIOUR (season-profile.py:
# cheat chest, dev NPCs, the early-access wipe notice). `dev` is the permanent
# dev realm: it is never a season and never production, and its names are
# number-independent, so SEASON_NUM there just records which season it feeds.

SEASON_WIKI_URL="https://dev.homerslotr.com/"   # this environment's own wiki
# Where PRODUCTION publishes - NOT the same question as SEASON_WIKI_URL above,
# which is this environment's own wiki. The dev realm needs it so the roadmap
# editor can offer a "LIVE roadmap" link alongside its own; for the live season
# the two are the same value. Defaults to the apex if unset, which is true by
# definition (the apex is bound to whichever season is live).
SEASON_LIVE_WIKI_URL="https://homerslotr.com/"
SEASON_WORKER_NAME="homers-lotr-wiki-dev"   # Cloudflare worker; must be unique
SEASON_CONNECT_HOST="homerslotr.ddns.net"   # host half of the module's "Connect:" line
