[Unit]
Description=Watch for the Anvil reboot-on-empty restart request flag
Documentation=file:///var/home/james/GIT/nwn_homers_lotr/bin/empty-restart-handler

[Path]
# The ServerRestartManager plugin drops this file after it exports characters and
# shuts the server down for an adhoc reboot-on-empty. Path is the host-visible
# Anvil PluginData dir (NWN_HOME_DIR/anvil/PluginData). Update if NWN_HOME_DIR moves.
PathExists=%h/.local/share/Neverwinter Nights/anvil/PluginData/restart-server
Unit=homers-lotr-empty-restart.service

[Install]
WantedBy=default.target
