[Unit]
# Web GUI for editing roadmap.yaml (the dev-roadmap / merit-tracking backlog).
# A user service so it runs as James.
#
# Binds 127.0.0.1 ONLY. Public access arrives through the Cloudflare Tunnel
# (roadmap-tunnel.service -> https://roadmap.homerslotr.com), which connects
# outbound and needs no forwarded port and no inbound firewall hole. Do not put
# --host 0.0.0.0 back: it would re-expose the editor on the LAN over plain HTTP,
# and the session cookie would travel in the clear.
#
# Every request needs a login. Accounts are managed only from a shell here:
#   python3 bin/roadmap-users.py add <user> --role admin|dm
#   python3 bin/roadmap-users.py list | roles | sessions | audit
# The account database lives outside the repo, at
# ~/.local/share/roadmap-editor/auth.sqlite3 -- it holds password hashes and
# live session tokens, so it is never committed and never leaves this machine.
#
# Always-on so the editor is a bookmark rather than a command to remember.
# Install:
#   systemctl --user enable --now roadmap-editor.service
#   loginctl enable-linger james     # so it starts at boot, before login
Description=Homer's LotR roadmap.yaml web editor (loopback :8765, behind the Cloudflare Tunnel)
Documentation=file:///var/home/james/GIT/nwn_homers_lotr/CLAUDE-roadmap.md
After=default.target

[Service]
Type=simple
WorkingDirectory=/var/home/james/GIT/nwn_homers_lotr
ExecStart=/usr/bin/python3 /var/home/james/GIT/nwn_homers_lotr/bin/roadmap-editor.py --serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
