[Unit]
# One terminal window at login showing EVERY realm's server log, interleaved and
# colour-tagged (bin/watch-all-servers). Replaces the three per-season XDG
# autostart entries that bin/season-shortcuts.sh used to write.
#
# ## Why a systemd unit and not ~/.config/autostart
#
# The XDG autostart entries never actually worked: gnome-session fires them
# before xdg-desktop-portal is up, and ptyxis needs the portal. Every boot ended
# like this (journal, 2026-08-14):
#
#   ptyxis[3064]: Cannot get portal org.freedesktop.portal.Settings: Timeout was reached
#   ptyxis[3035]: Could not activate remote peer 'org.freedesktop.portal.Desktop'
#   homers-lotr-monitor-test.desktop[3064]: Failed to register: Timeout was reached
#   ptyxis[3035]: Failed to spawn ptyxis-agent on the host system...
#   systemd-coredump[4391]: Process 3035 (ptyxis) dumped core.
#
# ...so the monitors had to be started by hand after every reboot. Three
# simultaneous ptyxis launches at t+0 also raced each other to be the primary
# instance. Ordering after the portal (and waiting on its bus name below) is the
# fix; a unit is also the only way to express that ordering.
#
# Install:  bin/monitor-all-shortcut.sh --install
# Logs:     journalctl --user -b -u nwn-monitor-all.service
Description=Homer's LotR — combined all-realm server monitor window
Documentation=file:///var/home/james/GIT/nwn_homers_lotr/bin/watch-all-servers
PartOf=graphical-session.target
After=graphical-session.target xdg-desktop-portal.service

[Service]
# oneshot, not simple: ptyxis is D-Bus activated, so `--new-window` hands the
# window to the ptyxis instance and returns straight away. The monitor lives in
# that window (its own ptyxis-spawn-*.scope), not in this unit — so "this unit
# is inactive" is the correct steady state, and `simple` would just make it look
# like something had died.
Type=oneshot
# Belt and braces with After= above: After only orders the START of the portal
# unit, not the moment it owns its bus name. ptyxis fails on the latter.
ExecStartPre=/usr/bin/gdbus wait --session --timeout 180 org.freedesktop.portal.Desktop
ExecStart=/usr/bin/ptyxis --new-window -- /var/home/james/GIT/nwn_homers_lotr/bin/watch-all-servers
# Nothing to restart, and a restart would only spawn duplicate windows.
Restart=no

[Install]
WantedBy=graphical-session.target
